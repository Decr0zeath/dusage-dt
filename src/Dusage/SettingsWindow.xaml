<Window x:Class="Dusage.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dUsage/dt settings" Width="420" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="#141517" Foreground="#E8E8E8"
        FontFamily="Segoe UI" FontSize="12.5" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Hyperlink.RequestNavigate="OnLink">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#1D1E22"/>
        <SolidColorBrush x:Key="LineBrush" Color="#2B2D33"/>
        <SolidColorBrush x:Key="DimBrush" Color="#9AA0A6"/>
        <SolidColorBrush x:Key="FaintBrush" Color="#71767D"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4F8EF7"/>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
            <Setter Property="Margin" Value="2,22,0,7"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <!-- On/off switch -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="36" Height="20" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="10" Background="#3A3D44"/>
                            <Ellipse x:Name="Knob" Width="14" Height="14" Margin="3,0" HorizontalAlignment="Left" Fill="#C4C8CE"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#484B53"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Fill" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One choice out of a few, as a row of pills -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#C9CDD3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" Background="#2A2C32" CornerRadius="5" Padding="8,3" Margin="4,0,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#353840"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Flat" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="#2A2C32" CornerRadius="5" Padding="12,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#353840"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#41454E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="#8AB4F8"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,20,22,18">
        <DockPanel>
            <Image x:Name="Logo" Width="44" Height="44" DockPanel.Dock="Left" Margin="0,0,14,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="20" FontWeight="SemiBold"><Run Text="dUsage"/><Run Text="/dt" Foreground="{StaticResource DimBrush}"/></TextBlock>
                <TextBlock x:Name="Tagline" Foreground="{StaticResource DimBrush}" Margin="0,1,0,0"/>
            </StackPanel>
        </DockPanel>

        <TextBlock Style="{StaticResource SectionTitle}" Text="SERVICES"/>
        <Border Style="{StaticResource Card}">
            <StackPanel x:Name="Services"/>
        </Border>
        <TextBlock Foreground="{StaticResource FaintBrush}" FontSize="11.5" Margin="2,7,0,0" TextWrapping="Wrap"
                   Text="A service you aren't signed in to stays off the widget until you sign in."/>

        <TextBlock Style="{StaticResource SectionTitle}" Text="WIDGET"/>
        <Border Style="{StaticResource Card}">
            <StackPanel x:Name="Options"/>
        </Border>

        <TextBlock Margin="2,22,0,0" Foreground="{StaticResource DimBrush}" FontSize="11.5" TextWrapping="Wrap">
            <Run Text="Made by"/>
            <Hyperlink x:Name="AuthorLink"><Run Text="Decr0zeath"/></Hyperlink>
            <Run Text="with Claude  ·  "/><Hyperlink x:Name="LicenseLink"><Run Text="MIT License"/></Hyperlink><Run Text="  ·  "/><Hyperlink x:Name="RepoLink"><Run Text="GitHub"/></Hyperlink>
        </TextBlock>
        <TextBlock Margin="2,6,0,0" Foreground="{StaticResource FaintBrush}" FontSize="10.5" TextWrapping="Wrap"
                   Text="Not affiliated with Anthropic or OpenAI. Claude is a trademark of Anthropic, PBC; ChatGPT and Codex are trademarks of OpenAI. Logos via Simple Icons."/>
    </StackPanel>
</Window>
