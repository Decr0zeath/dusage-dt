<Window x:Class="Dusage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dUsage/dt"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale"
        FontFamily="Segoe UI" FontSize="11" Foreground="#E8E8E8">

    <Border x:Name="Pill" CornerRadius="7" Background="#FA161618" BorderBrush="#2EFFFFFF" BorderThickness="1" Padding="7,2,8,3"
            MouseLeftButtonDown="OnPillMouseDown"
            ToolTipOpening="OnTipOpening"
            ToolTipService.InitialShowDelay="400" ToolTipService.ShowDuration="60000" ToolTipService.Placement="Top">
        <Border.ToolTip>
            <ToolTip x:Name="Tip" Background="#F21F2023" Foreground="#E8E8E8" BorderBrush="#33FFFFFF" Padding="10,8" FontSize="12"/>
        </Border.ToolTip>
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Refresh now" Click="OnRefreshClick"/>
                <MenuItem Header="Settings…" Click="OnSettingsClick"/>
                <Separator/>
                <MenuItem Header="Exit" Click="OnExitClick"/>
            </ContextMenu>
        </Border.ContextMenu>

        <!-- One row per service (logo, 5-hour bar, %, weekly bar, %), plus a row per extra limit; built in code. -->
        <Grid x:Name="Body">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
        </Grid>
    </Border>
</Window>
