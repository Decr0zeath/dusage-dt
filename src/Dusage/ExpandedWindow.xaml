<Window x:Class="Dusage.ExpandedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Dusage"
        Title="dUsage/dt" Icon="Assets/dusage.ico" Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="Manual" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="12.5" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale"
        MouseLeftButtonDown="OnDrag" KeyDown="OnKey" SizeChanged="OnSizeChanged"
        Hyperlink.RequestNavigate="OnLink">

    <Window.Resources>
        <!-- Cards let a little of the sky through. -->
        <SolidColorBrush x:Key="GlassBrush" Color="{x:Static local:Palette.Deep}" Opacity="0.88"/>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Serif}"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
            <Setter Property="Margin" Value="2,20,0,7"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="2,7,0,0"/>
        </Style>

        <!-- On/off switch -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="36" Height="20" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="10" Background="{StaticResource HoverBrush}"/>
                            <Ellipse x:Name="Knob" Width="14" Height="14" Margin="3,0" HorizontalAlignment="Left" Fill="{StaticResource DimBrush}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource PressBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Fill" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One choice out of a few, as a row of pills -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" Background="{StaticResource ControlBrush}" CornerRadius="5" Padding="8,3" Margin="4,0,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A level, as a track with a knob -->
        <Style x:Key="LevelPart" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{TemplateBinding Background}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Level" TargetType="Slider">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track" Height="20">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource LevelPart}" Background="{StaticResource AccentBrush}" Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource LevelPart}" Background="{StaticResource HoverBrush}" Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Width="16" Height="16" Fill="{StaticResource TextBrush}"
                                                     Stroke="{StaticResource CardBrush}" StrokeThickness="2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Flat" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="5" Padding="12,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource PressBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The one thing to do: install an update -->
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{x:Static local:Palette.NebulaGradient}" CornerRadius="5" Padding="12,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text that works as a button -->
        <Style x:Key="Link" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Label" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" Padding="2,2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="TextDecorations" Value="Underline"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A settings section's title, which opens and closes it -->
        <Style x:Key="SectionHead" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent" Margin="14,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" TextBlock.FontFamily="{StaticResource Serif}"
                                              TextBlock.FontStyle="Italic" TextBlock.FontSize="14"/>
                            <TextBlock x:Name="Chevron" Grid.Column="1" Text="&#xE70D;" FontSize="10" VerticalAlignment="Center"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- An icon that works as a button -->
        <Style x:Key="Glyph" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Width="30" Height="30" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource PressBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One page out of a few, as a word; the current one is lit -->
        <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <TextBlock x:Name="Label" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" Padding="2,2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="TextDecorations" Value="Underline"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Label" Property="TextDecorations" Value="{x:Null}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- The widget, grown: rounded like it and without a title bar. Drag it by any empty spot. -->
    <Border CornerRadius="10" Background="{StaticResource WindowBrush}" BorderBrush="#2EFFFFFF" BorderThickness="1">
        <Grid x:Name="Inside">
            <!-- Deep space behind everything; the rest floats on it. -->
            <local:Sky/>

            <StackPanel Margin="22,20,22,14">
                <!-- The name set as the fraction it is, d(Usage) over dt, in the logo's serif. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="Logo" Width="48" Height="48" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource Serif}" FontSize="19"><Run Text="d" FontStyle="Italic"/><Run Text="Usage"/></TextBlock>
                        <Border Height="1.5" Margin="-3,1,-3,2" Background="{x:Static local:Palette.NebulaGradient}"/>
                        <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource Serif}" FontSize="19" FontStyle="Italic" Text="dt"/>
                    </StackPanel>
                    <!-- Back to the little widget. Quitting is in the tray icon's menu. -->
                    <Button Grid.Column="2" Style="{StaticResource Glyph}" Content="&#xE73F;" VerticalAlignment="Top" Margin="0,-8,-12,0"
                            ToolTip="Collapse to the widget (Esc)" AutomationProperties.Name="Collapse to the widget" Click="OnCollapseClick"/>
                </Grid>

                <!-- The pages share one cell; the ones not showing are hidden rather than collapsed, so they still
                     take up room and the window keeps one size whichever page is open. -->
                <Grid>
                    <!-- Every limit, spelled out; built in code and redrawn along with the widget. -->
                    <StackPanel x:Name="UsagePage" Margin="0,20,0,0">
                        <StackPanel x:Name="Usage" Grid.IsSharedSizeScope="True"/>
                        <TextBlock x:Name="PaceNote" Style="{StaticResource Note}" Text="The tick marks how much of each window's time has passed."/>
                    </StackPanel>

                    <!-- A section per card, one open at a time; the page keeps the height of its tallest section (set in code). -->
                    <StackPanel x:Name="SettingsPage" Visibility="Hidden">
                        <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                            <StackPanel>
                                <ToggleButton x:Name="ServicesHead" Style="{StaticResource SectionHead}" Content="Services" Checked="OnSectionToggled" Unchecked="OnSectionToggled"/>
                                <StackPanel x:Name="ServicesBody" Visibility="Collapsed">
                                    <Border Height="1" Background="{StaticResource LineBrush}"/>
                                    <StackPanel x:Name="Services"/>
                                    <TextBlock Style="{StaticResource Note}" Margin="14,0,14,10" Text="The widget shows signed-in services only."/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                            <StackPanel>
                                <ToggleButton x:Name="WidgetHead" Style="{StaticResource SectionHead}" Content="Widget" Checked="OnSectionToggled" Unchecked="OnSectionToggled"/>
                                <StackPanel x:Name="WidgetBody" Visibility="Collapsed">
                                    <Border Height="1" Background="{StaticResource LineBrush}"/>
                                    <StackPanel x:Name="Options"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                            <StackPanel>
                                <ToggleButton x:Name="NumbersHead" Style="{StaticResource SectionHead}" Content="Numbers" Checked="OnSectionToggled" Unchecked="OnSectionToggled"/>
                                <StackPanel x:Name="NumbersBody" Visibility="Collapsed">
                                    <Border Height="1" Background="{StaticResource LineBrush}"/>
                                    <StackPanel x:Name="Reading"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                            <StackPanel>
                                <ToggleButton x:Name="ColorsHead" Style="{StaticResource SectionHead}" Content="Colors" Checked="OnSectionToggled" Unchecked="OnSectionToggled"/>
                                <StackPanel x:Name="ColorsBody" Visibility="Collapsed">
                                    <Border Height="1" Background="{StaticResource LineBrush}"/>
                                    <StackPanel x:Name="Warnings"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- A second click confirms; moving away or tabbing off calls it off. -->
                        <Button x:Name="RestoreButton" Style="{StaticResource Link}" Content="Restore defaults" HorizontalAlignment="Left"
                                Margin="0,10,0,0" Click="OnRestoreClick" MouseLeave="OnRestoreLeave" LostKeyboardFocus="OnRestoreLeave"
                                ToolTip="Every setting back to how it came. Start with Windows stays as it is."
                                AutomationProperties.Name="Restore default settings"/>
                    </StackPanel>

                    <StackPanel x:Name="InfoPage" Visibility="Hidden">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Updates"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel x:Name="Updates"/>
                        </Border>
    
                        <TextBlock Style="{StaticResource SectionTitle}" Text="About"/>
                        <Border Style="{StaticResource Card}" Padding="14,10">
                            <StackPanel TextBlock.Foreground="{StaticResource DimBrush}">
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="Made by Violdan “"/><Hyperlink x:Name="AuthorLink"><Run Text="Decr0zeath"/></Hyperlink><Run Text="” Bayocot with Claude."/>
                                </TextBlock>
                                <TextBlock Margin="0,4,0,0">
                                    <Hyperlink x:Name="RepoLink"><Run Text="GitHub"/></Hyperlink><Run Text="  ·  "/><Hyperlink x:Name="NotesLink"><Run Text="Release notes"/></Hyperlink><Run Text="  ·  "/><Hyperlink x:Name="LicenseLink"><Run Text="MIT License"/></Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Note}" FontSize="10.5"
                                   Text="Not affiliated with Anthropic, OpenAI, GitHub, Google or Moonshot AI. Claude is a trademark of Anthropic, PBC; ChatGPT and Codex are trademarks of OpenAI; GitHub and Copilot are trademarks of GitHub, Inc.; Gemini is a trademark of Google LLC; Kimi is a trademark of Moonshot AI. Logos via Simple Icons."/>
                    </StackPanel>
                </Grid>

                <DockPanel Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="UsageTab" Style="{StaticResource Tab}" GroupName="Page" Content="Usage" Checked="OnPageChecked"/>
                        <RadioButton x:Name="SettingsTab" Style="{StaticResource Tab}" GroupName="Page" Content="Settings" Checked="OnPageChecked"/>
                        <RadioButton x:Name="InfoTab" Style="{StaticResource Tab}" GroupName="Page" Content="Info" Checked="OnPageChecked"/>
                    </StackPanel>
                    <StackPanel x:Name="VersionPanel" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="FooterUpdate" Style="{StaticResource Primary}" Margin="0,0,10,0" Visibility="Collapsed" Click="OnUpdateClick"/>
                        <TextBlock x:Name="VersionText" Foreground="{StaticResource DimBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
